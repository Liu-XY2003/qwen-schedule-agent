{
  "_comment": "日程助手视觉 token —— 唯一事实源。网页版 (bridge/theme.py 生成 CSS 变量) 与安卓版 (AndroidTheme.kt) 都从这里派生，禁止各自手改。",
  "version": 2,

  "themes": {
    "paper": {
      "label": "纸感",
      "description": "暖米白 + 衬线标题，像一本高质量手账。适合长时间看课表。",
      "isDark": false,
      "colors": {
        "bg":        "#FAF8F5",
        "card":      "#FFFFFF",
        "card2":     "#F5F2EC",
        "line":      "#E9E4DC",
        "fg":        "#1C1B19",
        "muted":     "#8A8580",
        "accent":    "#3D5AFE",
        "onAccent":  "#FFFFFF",
        "chipBg":    "#F0ECE5",
        "ok":        "#2E7D32",
        "warn":      "#A66A00",
        "danger":    "#C62828",
        "shadow":    "0 1px 2px rgba(60,50,40,.06), 0 1px 8px rgba(60,50,40,.04)"
      },
      "modules": {
        "class":      "#2B5FD9",
        "exam":       "#C62828",
        "meeting":    "#7C4DFF",
        "assignment": "#8A7A00",
        "alarm":      "#B26A00",
        "reminder":   "#1E8E3E",
        "memo":       "#6B7A8F"
      },
      "radius": { "card": 16, "button": 12, "cell": 10, "chip": 999 },
      "font": {
        "title": "'Noto Serif SC','Songti SC','SimSun',Georgia,serif",
        "body":  "'Noto Sans SC',-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
        "numberVariant": "normal"
      },
      "calendarCell": {
        "markerStyle": "dot",
        "markerSize": 5,
        "maxMarkers": 3
      },
      "eventChip": { "barWidth": 0 },
      "motion": { "durationMs": 200, "easing": "ease-out" }
    },

    "night": {
      "label": "夜航",
      "description": "近黑底 + 高对比，类似 Linear/Vercel 的暗色后台。适合夜间与开发者审美。",
      "isDark": true,
      "colors": {
        "bg":        "#0E1116",
        "card":      "#161B22",
        "card2":     "#1B2129",
        "line":      "#252C37",
        "fg":        "#E6E8EB",
        "muted":     "#7D8B9A",
        "accent":    "#3D7EFF",
        "onAccent":  "#FFFFFF",
        "chipBg":    "#1C2430",
        "ok":        "#3FB950",
        "warn":      "#D29922",
        "danger":    "#F85149",
        "shadow":    "none"
      },
      "modules": {
        "class":      "#3D7EFF",
        "exam":       "#F85149",
        "meeting":    "#C9A6FF",
        "assignment": "#D3D95F",
        "alarm":      "#F0B357",
        "reminder":   "#3FB950",
        "memo":       "#8FA3B8"
      },
      "radius": { "card": 12, "button": 9, "cell": 8, "chip": 999 },
      "font": {
        "title": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
        "body":  "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
        "numberVariant": "tabular-nums"
      },
      "calendarCell": {
        "markerStyle": "bar",
        "markerSize": 3,
        "maxMarkers": 3
      },
      "eventChip": { "barWidth": 3 },
      "motion": { "durationMs": 150, "easing": "ease-out" }
    }
  },

  "defaultTheme": "night",
  "followSystem": true
}
